{
    "name": "fulgurite/plugin-sandbox",
    "type": "project",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Plugins\\Sandbox\\": "src/",
            "Plugins\\CoreReadModels\\": "packages/CoreReadModels/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
